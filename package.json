{
  "name": "rbac-boilerplate-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "packages/cli"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "migrate": "npm run migrate --workspace=backend",
    "migrate:dev": "npm run migrate:dev --workspace=backend",
    "migrate:reset": "npm run migrate:reset --workspace=backend",
    "migrate:rollback": "npm run migrate:rollback --workspace=backend",
    "prisma:generate": "npm run prisma:generate --workspace=backend",
    "seed": "npm run seed --workspace=backend",
    "create-admin": "tsx backend/scripts/create-admin.ts",
    "test": "npm run test --workspace=backend && npm run test --workspace=frontend",
    "lint": "npm run lint --workspace=backend && npm run lint --workspace=frontend",
    "typecheck": "npm run typecheck --workspace=backend && npm run typecheck --workspace=frontend",
    "build:cli": "npm run build --workspace=packages/cli"
  }
}
