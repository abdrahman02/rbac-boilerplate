# ============================================================
# RBAC Boilerplate — Environment Variables
# Copy file ini ke .env dan isi dengan nilai lokal Anda
# ============================================================

# Server
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database — pastikan MySQL lokal sudah berjalan
# Setup awal (jalankan di MySQL client / TablePlus sekali saja):
#   CREATE DATABASE IF NOT EXISTS rbac_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER IF NOT EXISTS 'rbac_user'@'localhost' IDENTIFIED BY 'rbac_password';
#   GRANT ALL PRIVILEGES ON rbac_db.* TO 'rbac_user'@'localhost';
#   FLUSH PRIVILEGES;
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rbac_db
DB_USER=rbac_user
DB_PASSWORD=rbac_password

# JWT — gunakan string acak minimal 32 karakter
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-here-replace-this
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-here-replace-this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (SMTP)
# Development: gunakan Mailtrap sandbox
#   SMTP_USER & SMTP_PASS → Mailtrap Dashboard → Email Testing
#   → Inboxes → klik inbox → tab Integration → pilih SMTP
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-mailtrap-smtp-user
SMTP_PASS=your-mailtrap-smtp-password
SMTP_FROM=noreply@rbac-app.dev

# App
APP_NAME=RBAC App
